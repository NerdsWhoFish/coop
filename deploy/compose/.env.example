# Copy to .env and fill in.

# Released semantic version or immutable image digest.
COOP_IMAGE=ghcr.io/nerdswhofish/coop:0.1.0

# Public DNS hostname pointed at this host.
COOP_HOSTNAME=coop.example.com

# Optional over-the-air iOS release metadata, read from a Fledge server.
COOP_UPDATES_ENABLED=false
COOP_UPDATES_BASE_URL=
