# Copy to .env and fill in.

# Postgres password. Any long random string.
POSTGRES_PASSWORD=

# Externally reachable base URL for this instance.
# Child devices embed this during pairing, so a wrong value produces devices
# that pair successfully and then reach nothing.
COOP_PUBLIC_URL=https://coop.example

# Encrypts YouTube API keys and TOTP secrets at rest.
# Generate with: openssl rand -base64 32
# Losing this means re-entering every family's API key.
COOP_AUTH_ENCRYPTION_KEY=
