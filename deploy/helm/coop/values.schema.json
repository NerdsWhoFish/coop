{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": { "type": "integer", "const": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": { "type": "object" },
    "ingress": { "type": "object" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicURL", "logLevel", "logFormat", "existingSecret", "databaseDSNKey", "authEncryptionKeyKey"],
      "properties": {
        "publicURL": { "type": "string", "pattern": "^https://" },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "enum": ["json", "text"] },
        "existingSecret": { "type": "string", "minLength": 1 },
        "databaseDSNKey": { "type": "string", "minLength": 1 },
        "authEncryptionKeyKey": { "type": "string", "minLength": 1 }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "baseURL", "parentBundleID", "childBundleID"],
      "properties": {
        "enabled": { "type": "boolean" },
        "baseURL": { "type": "string", "pattern": "^(https://.+)?$" },
        "parentBundleID": { "type": "string" },
        "childBundleID": { "type": "string" }
      }
    },
    "apns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "keyID": { "type": "string" },
        "teamID": { "type": "string" },
        "environment": { "enum": ["production", "development"] },
        "keySecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["otlpEndpoint", "environment"],
      "properties": {
        "otlpEndpoint": { "type": "string", "pattern": "^(http://.+)?$" },
        "environment": { "type": "string", "minLength": 1 }
      }
    },
    "resources": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "required": ["replicaCount", "image", "config", "updates", "observability"]
}
